# Copie para .env e ajuste os valores

# --- Banco (Prisma) ---
# Desenvolvimento: SQLite (schema.prisma)
DATABASE_URL="file:./data/app.db"
# Producao (MySQL/RDS): DATABASE_URL + npm run db:generate:mysql (docs/10)
#   ex.: mysql://central:senha@host:3306/central
#          + scripts: db:push:mysql -> db:migrate-to-mysql -- --yes
# SQLITE_DATABASE_URL="file:./data/app.db"   # usado pelo script de migracao

JWT_SECRET="gere-um-segredo-aleatorio-de-32-caracteres-ou-mais"
SESSIONS_DIR="./sessions"

# --- Storage de arquivos (docs/10-mysql-e-s3.md) ---
# local (default, dev): DISCO em MEDIA_DIR
STORAGE_DRIVER="local"
MEDIA_DIR="./media"
# s3 (producao): bucket PRIVADO; o app le/grava pela API autenticada
# (/api/media/[name]) — o bucket nunca fica publico.
# STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_PREFIX="media"
S3_ENDPOINT=""   # opcional: MinIO/LocalStack/Wasabi/other compat S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
