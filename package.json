{
  "name": "central-atendimento",
  "version": "0.1.0",
  "private": true,
  "description": "Central de atendimento multicanal (WhatsApp) multi-setor e multi-numero",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push:mysql": "prisma db push --schema prisma/schema.mysql.prisma",
    "db:generate:mysql": "prisma generate --schema prisma/schema.mysql.prisma",
    "db:studio:mysql": "prisma studio --schema prisma/schema.mysql.prisma",
    "db:migrate-to-mysql": "node scripts/sqlite-to-mysql.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^6.2.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.1.5",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@whiskeysockets/baileys@6.7.24": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true
  }
}
