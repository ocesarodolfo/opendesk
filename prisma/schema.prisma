// =====================================================================
// Modelo de dados - Central de Atendimento Multicanal
// Documentacao completa em: docs/03-modelo-de-dados.md
//
// SQLite agora | MySQL depois: basta trocar o provider abaixo e rodar
// `npx prisma migrate reset` (ver docs para o passo a passo)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// USUARIOS E SETORES
// ---------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  // "ADMIN" | "AGENT" (SQLite nao suporta enum nativo)
  role         String        @default("AGENT")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships            SectorMembership[]
  assignedConversations  Conversation[]     @relation("AssignedUser")
  pushSubscriptions      PushSubscription[]
}

model Sector {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  memberships   SectorMembership[]
  numbers       WhatsAppNumber[]
  conversations Conversation[]
  quickReplies  QuickReply[]
}

model SectorMembership {
  id       String   @id @default(uuid())
  userId   String
  sectorId String
  role     String   @default("AGENT") // reserva p/ futura granularidade (SUPERVISOR)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([userId, sectorId])
}

// ---------------------------------------------------------------------
// CANAIS / NUMEROS
// ---------------------------------------------------------------------

// Por enquanto apenas WhatsApp (nao-oficial via Baileys).
// A tabela foi desenhada para receber outros canais no futuro
// (WhatsApp Cloud API, Telegram, Instagram Direct etc.) - ver docs/08
model WhatsAppNumber {
  id          String   @id @default(uuid())
  label       String // "Suporte - 55 11 9999-0000"
  // Identificador real atribuido pelo WhatsApp apos o pareamento
  phone       String?
  jid         String?
  // "DISCONNECTED" | "CONNECTING" | "CONNECTED"
  status      String   @default("DISCONNECTED")
  // Último erro reportado pela conexao (p/ diagnostico no painel)
  lastError   String?
  // logotipo: prefixar "[Nome do atendente]" nas mensagens enviadas pelo painel,
  // para o contato saber quem do setor esta falando
  prefixAgent Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sector        Sector?  @relation(fields: [sectorId], references: [id])
  sectorId      String?
  conversations Conversation[]
}

// ---------------------------------------------------------------------
// ATENDIMENTO
// ---------------------------------------------------------------------

// Respostas rapidas do atendente (canned replies) — globais ou por setor
model QuickReply {
  id       String   @id @default(uuid())
  // atalho curto exibido na lista (ex.: "acima", "senha-ti", "tchau")
  shortcut String
  content  String
  active   Boolean  @default(true)
  createdAt DateTime @default(now())

  // null = disponivel em todos os setores (nivel empresa)
  sector   Sector?  @relation(fields: [sectorId], references: [id])
  sectorId String?

  @@index([active, sectorId])
}

model Contact {
  id        String   @id @default(uuid())
  // Somente digitos, com DDI ex.: 5511999990000
  // Para grupos, guarda os digitos do id do grupo (chave unica)
  phone     String   @unique
  name      String?
  pushName  String?
  // Grupo do WhatsApp (@g.us): conversa com varios participantes
  isGroup   Boolean  @default(false)
  // Ultimo jid remoto conhecido (conta nova usa "@lid"); responde por ele
  jid       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  tags          ContactTag[]
}

model Conversation {
  id             String   @id @default(uuid())
  // "PENDING" | "OPEN" | "CLOSED"
  // PENDING = nova conversa aguardando agente pegar; OPEN = em atendimento
  status         String   @default("PENDING")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  // momento do encerramento (limpo ao reabrir) — usado nos relatorios
  closedAt       DateTime?

  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  whatsappNumber  WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id])
  whatsappNumberId String
  sector          Sector?       @relation(fields: [sectorId], references: [id])
  sectorId        String?
  assignedUser    User?         @relation("AssignedUser", fields: [assignedUserId], references: [id])
  assignedUserId  String?

  messages Message[]

  @@index([status, lastMessageAt])
  @@index([whatsappNumberId, contactId])
}

model Message {
  id             String   @id @default(uuid())
  // "INCOMING" | "OUTGOING"
  direction      String
  content        String // texto e/ou legenda da midia
  // Midia (v2): arquivo gravado em MEDIA_DIR/<mediaUrl>
  mediaUrl       String?
  mediaType      String? // mimetype ("image/jpeg", "audio/mp4"...)
  fileName       String? // nome original de documentos
  // "SENT" | "FAILED" (evolucoes: DELIVERED/READ)
  status         String   @default("SENT")
  // Id da mensagem no lado do WhatsApp (deduplicacao)
  externalId     String?
  // nao lida pelo painel: INCOMING ainda nao vista por um atendente (badges)
  viewed         Boolean  @default(false)
  // Em grupos (@g.us): nome exibido do participante que enviou a mensagem
  senderName     String?
  // Em grupos: jid do participante autor (necessario para reagir a mensagem dele)
  senderJid      String?
  // Resposta citando outra mensagem (reply do WhatsApp)
  quotedSnippet  String? // texto/vista rapida da mensagem citada
  quotedSender   String? // telefone de quem enviou a mensagem original
  quotedSenderName String? // nome resolvida de quem falou a mensagem citada
  // Reacao (emoji) na mensagem — uma por mensagem (ultima vence)
  reaction       String?
  // true = reacao colocada pelo atendente (painel); false/undefined = do contato
  reactionMine   Boolean?
  // "Apagar para todos": a mensagem foi revogada no WhatsApp
  deleted        Boolean  @default(false)
  // mensagem encaminhada (chega com contextInfo.isForwarded no WhatsApp)
  forwarded      Boolean  @default(false)
  // agrupa mensagens de midia enviadas juntas (album de imagens)
  groupKey       String?
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------
// ETIQUETAS (TAGS) DE CONTATO
// ---------------------------------------------------------------------

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("slate") // emerald | sky | amber | rose | violet | slate
  createdAt DateTime @default(now())

  contacts ContactTag[]
}

// Join table contato <-> etiqueta
model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// ---------------------------------------------------------------------
// AUDITORIA (trilha de acoes) — append-only, SEM FK: a trilha sobrevive
// a exclusao de usuarios/conversas. actorName e snapshot denormalizado.
// ---------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  // "LOGIN" | "CONVERSA_STATUS" | "MENSAGEM_ENVIADA" ... (ver src/lib/audit.ts)
  action    String
  // entidade afetada: "User" | "Conversation" | "Contact" | "WhatsAppNumber" | "Sector" | "Tag" | "QuickReply"
  entity    String
  entityId  String?
  // resumo legivel: "status PENDING -> CLOSED", "atribuida a Maria", primeira linha da msg
  detail    String?
  // quem fez (null = sistema/boot)
  actorId   String?
  actorName String?
  // contexto tecnico
  ip        String?
  userAgent String?
  // JSON opcional com o antes/depois detalhado
  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId, createdAt])
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  endpointHash String   @unique
  endpoint     String
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
